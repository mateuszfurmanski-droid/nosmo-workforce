<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Package visibility is deliberately narrow. This is the exact controlled
      set currently enabled for Android discovery in Construction App Registry.
      Broad installed-package inventory permission is forbidden for Work Card discovery.
    -->
