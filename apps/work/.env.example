# NOSMO Work / Worker hosted runtime configuration
#
# Copy key names only into the hosting environment. Never commit real values.
# ChatGPT Sites hosted secrets must be configured in the Site settings.

# Required for persisted Worker identity, status and Agency consent records.
DATABASE_URL=

# Required. Use a cryptographically random secret of at least 32 bytes.
# Rotating this value changes the pseudonymous identity digest mapping.
NEXUS_IDENTITY_PEPPER=

# Required only for Ask Nexus / document-analysis features that call OpenAI.
OPENAI_API_KEY=

# Optional model override. Leave blank to use the application default.
OPENAI_MODEL=
