# NOSMO Agency / Worker security-sensitive runtime configuration.
# PLACEHOLDERS ONLY. Never commit real credentials.

NODE_ENV=production
PORT=4178

# PostgreSQL / Neon. Use a dedicated least-privilege application role where feasible.
# Keep TLS certificate verification enabled; do not use rejectUnauthorized=false.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DB_HOST/DB_NAME?sslmode=verify-full

# Agency OIDC.
OIDC_CLIENT_ID=replace-with-provider-client-id
ISSUER_URL=https://replace-with-oidc-issuer.example
NOSMO_AGENCY_PUBLIC_ORIGIN=https://agency.example.com

# Worker onboarding handoff.
WORK_APP_BASE_URL=https://work.example.com
NEXUS_ONBOARDING_PUBLIC_ORIGINS=https://work.example.com
NEXUS_ONBOARDING_INVITE_SECRET=replace-with-random-secret-at-least-32-bytes
NEXUS_ONBOARDING_DRAFT_SECRET=replace-with-separate-random-secret-at-least-32-bytes

# Integration security QA only. Never point this at production.
SECURITY_QA_DATABASE_URL=postgresql://QA_USER:QA_PASSWORD@ISOLATED_BRANCH_HOST/QA_DATABASE?sslmode=verify-full
SECURITY_QA_ALLOW_MUTATION=isolated-branch
